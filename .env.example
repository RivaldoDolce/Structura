# ──────────────────────────────────────────────
# VARIABLES D'ENVIRONNEMENT — STRUCTURA
# Copier ce fichier en .env.local et remplir les valeurs
# ──────────────────────────────────────────────

# ── Base de données ──────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/structura?sslmode=require"

# ── Auth.js ──────────────────────────────────
AUTH_SECRET="generer-avec-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optionnel, phase 2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── CinetPay (Paiement) ─────────────────────
CINETPAY_API_KEY=""
CINETPAY_SECRET_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_MODE="sandbox"

# ── Cloudflare R2 (Stockage fichiers) ────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="structura-files"
R2_PUBLIC_URL="https://pub-YOUR_ID.r2.dev"

# ── Resend (Emails transactionnels) ──────────
RESEND_API_KEY=""
RESEND_FROM="STRUCTURA <noreply@structura-cm.com>"

# ── Upstash Redis (Cache + Rate Limiting) ────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Sentry (Monitoring) ─────────────────────
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="STRUCTURA"
NEXT_PUBLIC_WHATSAPP_NUMBER="+237600000000"
