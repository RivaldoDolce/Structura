    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
